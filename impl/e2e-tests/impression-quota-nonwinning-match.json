    },
    {
      "event": "measureConversion",
      "seconds": 7,
      "site": "fresh-advertiser.example",
      "options": {
        "aggregationService": "https://agg-service.example",
        "epsilon": 1,
        "histogramSize": 2,
        "lookbackDays": 1,
        "value": 1,
        "maxValue": 1,
        "impressionSites": ["losing-publisher.example"]
      },
      "expected": [0, 0],
      "$comment": "The nonwinning publisher is exhausted even when queried alone."
    }
