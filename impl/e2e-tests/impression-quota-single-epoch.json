      "seconds": 3,
      "site": "advertiser-0.example",
      "options": {
        "aggregationService": "https://agg-service.example",
        "epsilon": 1,
        "histogramSize": 2,
        "lookbackDays": 1,
        "value": 1,
        "maxValue": 1
      },
      "expected": [0, 1],
      "$comment": "Deduct 1M once for this publisher despite two matching impressions. The fourth call exactly exhausts its 4M quota."
    },
    {
